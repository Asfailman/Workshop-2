<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <!-- Camera -->
        <LinearLayout
            android:id="@+id/menuCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:contentDescription="Camera"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#1987b8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Camera"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Arrow"
                android:src="@android:drawable/ic_media_play"
                app:tint="#94A3B8" />
        </LinearLayout>

        <!-- Upload Photo -->
        <LinearLayout
            android:id="@+id/menuUploadPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:contentDescription="Upload Photo"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="#1987b8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Upload Photo"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Arrow"
                android:src="@android:drawable/ic_media_play"
                app:tint="#94A3B8" />
        </LinearLayout>

        <!-- Upload File -->
        <LinearLayout
            android:id="@+id/menuUploadFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:contentDescription="Upload File"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#1987b8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Upload File"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Arrow"
                android:src="@android:drawable/ic_media_play"
                app:tint="#94A3B8" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
