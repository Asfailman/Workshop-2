<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvRoomBlockBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1987b8"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="BLOK E2"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRoomMalayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Makmal Pengaturcaraan 1" />

            <TextView
                android:id="@+id/tvRoomEnglishName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:text="Programming Lab 1" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvRoomCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F1F5F9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Lab"
            android:textColor="#475569"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
