<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- WebView Container for HTML 3D Map -->
    <WebView
        android:id="@+id/webViewInteractiveMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Simple Top Back Button Floating over Map -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@android:drawable/dialog_holo_dark_frame"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        android:elevation="8dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Bottom Robot Status HUD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRobotStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#1E293B">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Robot Navigation HUD"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Distance: -- m"
                    android:textColor="#38BDF8"
                    android:layout_weight="1"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ETA: -- sec"
                    android:textColor="#38BDF8"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvWaypoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waypoints: 0"
                android:textColor="#94A3B8"
                android:layout_marginTop="4dp"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>