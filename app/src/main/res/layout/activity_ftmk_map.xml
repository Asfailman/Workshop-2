<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayoutMap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1987b8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackMap"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="FTMK Building Floor Map"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Selected Room Info Header Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSelectedRoom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayoutMap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSelectedRoomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bilik Kuliah 3 (Lecture Room 3)"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSelectedLevelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1987b8"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LEVEL 1 (ARAS 1)"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedBlockBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#EF4444"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🔴 Marked on Floor Map"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Floor Level Selector Tabs -->
    <LinearLayout
        android:id="@+id/levelSelectorContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardSelectedRoom">

        <Button
            android:id="@+id/btnLevel1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Aras 1"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLevel2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Aras 2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLevel3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Aras 3"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLevel4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aras 4"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Visual FTMK Floor Map Image Frame Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMapDiagram"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/levelSelectorContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mapContainerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FAF8F5"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvFloorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FTMK MAP - LEVEL 1 (ARAS 1)"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- FTMK Floor Map Image -->
            <ImageView
                android:id="@+id/ivFtmkMapImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/map_ftmk_level_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFloorTitle" />

            <!-- RED DOT MARKER (Dynamically positioned over the map image) -->
            <LinearLayout
                android:id="@+id/layoutRedDotMarker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/ivFtmkMapImage"
                app:layout_constraintEnd_toEndOf="@id/ivFtmkMapImage"
                app:layout_constraintHorizontal_bias="0.82"
                app:layout_constraintStart_toStartOf="@id/ivFtmkMapImage"
                app:layout_constraintTop_toTopOf="@id/ivFtmkMapImage"
                app:layout_constraintVertical_bias="0.72">

                <TextView
                    android:id="@+id/tvRedDotLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#EF4444"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="📍 Bilik Kuliah 3"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_red_dot_marker" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Rooms Directory List Header -->
    <TextView
        android:id="@+id/tvRoomsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:text="Directory Rooms on this Floor:"
        android:textColor="#1E293B"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardMapDiagram" />

    <!-- RecyclerView for Floor Rooms Directory -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFloorRooms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRoomsTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
